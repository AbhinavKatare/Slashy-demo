# -------------------------------------------------------------
# Inbox Companion Server Environment Configuration
# -------------------------------------------------------------

PORT=3000
NODE_ENV=development
API_PREFIX=v1

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inbox_companion_dev
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets (Fictional development secrets only)
JWT_ACCESS_SECRET=dev_jwt_access_secret_fictional_minimum_32_characters_long_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_fictional_minimum_32_characters_long_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Credential Encryption (AES-256-GCM - exactly 32 bytes hex)
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS & Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,inboxcompanion://
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# OIDC Mock / Dev Settings
OIDC_GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
OIDC_GOOGLE_CLIENT_SECRET=mock-google-client-secret
OIDC_MICROSOFT_CLIENT_ID=mock-ms-client-id
OIDC_MICROSOFT_CLIENT_SECRET=mock-ms-client-secret

# Mailpit (Local SMTP / Dev)
SMTP_HOST=localhost
SMTP_PORT=1025
